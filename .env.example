# ==============================================================================
# Gayatri E-Commerce - Environment Configuration Reference
# ==============================================================================

# ------------------------------------------------------------------------------
# Core Django Settings
# ------------------------------------------------------------------------------
# Generate a strong secret key for production (e.g. `python -c "import secrets; print(secrets.token_urlsafe(50))"`)
SECRET_KEY=replace-with-a-secure-random-secret-key-in-production

# Set to False in production
DEBUG=False

# Comma-separated list of allowed hostnames. Use * for testing or your specific domain
ALLOWED_HOSTS=*.northflank.app,yourdomain.com

# Comma-separated list of trusted origins for CSRF POST requests (must include scheme https://)
CSRF_TRUSTED_ORIGINS=https://*.northflank.app,https://yourdomain.com

# Number of category columns shown in header dropdown (default 6)
CATEGORY_COLUMN_LENGTH=6

# ------------------------------------------------------------------------------
# Database (PostgreSQL)
# ------------------------------------------------------------------------------
# On Northflank: create a PostgreSQL addon.
# Either use DATABASE_URL or link POSTGRES_URI from the addon.
# Format: postgres://username:password@host:port/database
DATABASE_URL=postgres://postgres:password@postgres-addon:5432/gayatri_db
# POSTGRES_URI=postgres://postgres:password@postgres-addon:5432/gayatri_db

# ------------------------------------------------------------------------------
# Cache & Rate Limiting (Redis)
# ------------------------------------------------------------------------------
# On Northflank: create a Redis addon.
# Format: redis://[:password@]host:port/db_number
REDIS_URL=redis://default:password@redis-addon:6379/0
# REDIS_URI=redis://default:password@redis-addon:6379/0

# Rate limit for contact form submissions (e.g. '5/m' = 5 per minute)
EMAIL_RATELIMIT=5/m

# ------------------------------------------------------------------------------
# Cloudinary (Media Asset Storage)
# ------------------------------------------------------------------------------
# Obtain these from your Cloudinary dashboard (https://cloudinary.com)
CLOUD_NAME=your-cloudinary-cloud-name
API_KEY=your-cloudinary-api-key
API_SECRET=your-cloudinary-api-secret

# ------------------------------------------------------------------------------
# Email Service (SMTP)
# ------------------------------------------------------------------------------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-specific-password
